{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deaf Safaris: Start development server",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "5173",
        "--strictPort"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite",
          "endsPattern": "Local:.*http://127\\.0\\.0\\.1:5173/"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Deaf Safaris: Production build",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Deaf Safaris: Lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Deaf Safaris: Check formatting",
      "type": "npm",
      "script": "format:check",
      "problemMatcher": []
    },
    {
      "label": "Deaf Safaris: Check all",
      "dependsOrder": "sequence",
      "dependsOn": ["Deaf Safaris: Lint", "Deaf Safaris: Check formatting"],
      "problemMatcher": []
    }
  ]
}
